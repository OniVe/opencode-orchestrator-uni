{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-orchestrator-uni",
  "version": "0.1.0",
  "description": "Native OpenCode V2 plugin that registers the orchestrator agent kit (root orchestrator, audit subagents, fix-runner) and exposes the kit's process documents as the audit-kit reference.",
  "type": "module",
  "license": "MIT",
  "author": "OniVe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OniVe/opencode-orchestrator-uni.git"
  },
  "homepage": "https://github.com/OniVe/opencode-orchestrator-uni#readme",
  "bugs": {
    "url": "https://github.com/OniVe/opencode-orchestrator-uni/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agents",
    "orchestrator",
    "subagents",
    "audit"
  ],
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "files": [
    "index.ts",
    "lib",
    "schemas",
    "agents",
    "docs",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test/",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:locales": "bun tools/locale-check.ts",
    "eval": "bun eval/run.ts",
    "eval:selfcheck": "bun eval/selfcheck.ts",
    "eval:recompute": "bun eval/recompute.ts"
  },
  "dependencies": {
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@opencode/plugin": "^2.0.28",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.8.2"
  }
}
