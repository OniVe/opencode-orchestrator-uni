{
  "id": "audit-redteam/v1",
  "schema": {
    "type": "object",
    "required": [
      "schema",
      "verdict",
      "closing_list",
      "coverage_gaps",
      "claims_attacked",
      "findings",
      "not_verified"
    ],
    "properties": {
      "schema": { "type": "string", "const": "audit-redteam/v1" },
      "verdict": { "type": "string", "enum": ["ready", "not_ready"] },
      "closing_list": { "type": "array", "items": { "type": "string" } },
      "coverage_gaps": { "type": "array", "items": { "type": "string" } },
      "claims_attacked": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["claim", "attack", "outcome", "evidence"],
          "properties": {
            "claim": { "type": "string" },
            "attack": { "type": "string" },
            "outcome": {
              "type": "string",
              "enum": ["claim_refuted", "claim_confirmed", "claim_partial", "unverifiable"]
            },
            "evidence": { "type": "string" }
          }
        }
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "severity", "location", "mechanism", "evidence", "fix"],
          "properties": {
            "id": { "type": "string" },
            "severity": { "type": "string", "enum": ["MAJOR", "MINOR", "NIT"] },
            "location": { "type": "string" },
            "mechanism": { "type": "string" },
            "evidence": { "type": "string" },
            "fix": { "type": "string" }
          }
        }
      },
      "not_verified": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["item", "why"],
          "properties": {
            "item": { "type": "string" },
            "why": { "type": "string" }
          }
        }
      }
    }
  }
}
